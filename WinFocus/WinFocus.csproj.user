<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="Current" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <UapAppxPackageBuildMode>SideloadOnly</UapAppxPackageBuildMode>
    <AppxShowAllApps>False</AppxShowAllApps>
    <AppxBuildConfigurationSelection>x86|x64</AppxBuildConfigurationSelection>
    <PackageOptionalProjectsInIdeBuilds>False</PackageOptionalProjectsInIdeBuilds>
    <DeployOptionalPackages>True</DeployOptionalPackages>
    <AppIconSource>D:\Projects\WinFocus\WinFocus\Assets\WindowIcon_256x256.png</AppIconSource>
    <Source>D:\Projects\WinFocus\WinFocus\Assets\WindowIcon_256x256.png</Source>
    <SmallTileSource>D:\Projects\WinFocus\WinFocus\Assets\WindowIcon_256x256.png</SmallTileSource>
    <MediumTileSource>D:\Projects\WinFocus\WinFocus\Assets\WindowIcon_256x256.png</MediumTileSource>
    <WideTileSource>D:\Projects\WinFocus\WinFocus\Assets\WindowIcon_256x256.png</WideTileSource>
    <LargeTileSource>D:\Projects\WinFocus\WinFocus\Assets\WindowIcon_256x256.png</LargeTileSource>
    <SplashScreenSource>D:\Projects\WinFocus\WinFocus\Assets\WindowIcon_256x256.png</SplashScreenSource>
    <PackageLogoSource>D:\Projects\WinFocus\WinFocus\Assets\WindowIcon_256x256.png</PackageLogoSource>
  </PropertyGroup>
  <ItemGroup>
    <Page Update="Views\BingWallpaperPage.xaml">
